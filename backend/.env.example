# Copy this file to .env and replace the empty key with your own OpenAI API key.
# backend/.env is ignored by git. Do not commit a real key.
# Render does not use this file. Set the same names in the Render dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Hosted production only. Leave these empty for local development.
# GOOGLE_CLIENT_ID is the Chrome extension client ID from manifest.json, not a secret.
# ALLOWED_EMAILS is the server-side allowlist. Do not put it in the extension.
GOOGLE_CLIENT_ID=
ALLOWED_EMAILS=

# Optional. Defaults are 30 parse requests per approved Google account per 15 minutes.
# QUICKCAL_RATE_LIMIT_MAX=30
# QUICKCAL_RATE_LIMIT_WINDOW_MS=900000
