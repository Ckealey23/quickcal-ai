{
  "manifest_version": 3,
  "name": "QuickCalAI",
  "version": "0.1.0",
  "key": "",
  "description": "Type a calendar event from any webpage.",
  "action": {
    "default_title": "Show or hide QuickCalAI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "identity", "storage", "offscreen", "contextMenus"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://www.googleapis.com/calendar/*",
    "https://oauth2.googleapis.com/*",
    "https://quickcal-ai.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "shared/schedule.js",
        "shared/preview.js",
        "shared/startup.js",
        "shared/selection.js",
        "shared/layout.js",
        "shared/lookup.js",
        "content/widget.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "942667174356-iqt4btv1vojdqr2lg97unc1jl22si0ht.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events.owned",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/mic.svg", "assets/check.svg", "assets/calendar.svg", "assets/clock.svg", "assets/chevron.svg", "content/widget.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
