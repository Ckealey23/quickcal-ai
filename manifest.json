{
  "manifest_version": 3,
  "name": "QuickCalAI",
  "version": "0.1.0",
  "key": "",
  "description": "Type a calendar event from any webpage.",
  "action": {
    "default_title": "Show or hide QuickCalAI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "identity", "storage"],
  "host_permissions": [
    "https://www.googleapis.com/calendar/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "942667174356-iqt4btv1vojdqr2lg97unc1jl22si0ht.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.events.owned"]
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/mic.svg", "content/widget.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
